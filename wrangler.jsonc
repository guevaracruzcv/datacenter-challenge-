{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "datacenter-challenge",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datacenter-challenge-db",
      "database_id": "local-datacenter-challenge-db",
      "preview_database_id": "local-datacenter-challenge-db",
      "migrations_dir": "database/migrations"
    }
  ]
}
